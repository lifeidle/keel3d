{
  "name": "keel3d",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "KeeL 3D — WebGPU browser game framework (Specul). Samples: nightraid / tower / cultivation.",
  "license": "MIT",
  "author": "Specul / KeeL 3D authors",
  "repository": {
    "type": "git",
    "url": "https://github.com/specul/keel3d"
  },
  "homepage": "https://3d.specul.com",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "net:dev": "vite --port 8799 --host",
    "site-audit": "node scripts/site-audit.mjs",
    "assets:webp": "node scripts/assets-webp.mjs",
    "assets:encode": "node scripts/assets-encode.mjs",
    "new-game": "node scripts/new-game.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d": "^0.20.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@gltf-transform/cli": "^4.5.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/three": "^0.186.0",
    "draco3d": "^1.5.7",
    "meshoptimizer": "^1.2.0",
    "playwright": "^1.63.0",
    "sharp": "^0.34.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  },
  "allowScripts": {
    "sharp@0.35.2": true,
    "sharp@0.34.5": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260908.1": true,
    "workerd@1.20260911.1": true
  }
}
